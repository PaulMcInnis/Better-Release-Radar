{
  "name": "better-release-radar",
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "html": "tsx src/build-html.ts",
    "typecheck": "tsc --noEmit",
    "radar": "npm start -- --max-age-days 360 --json out/releases.json --html out/releases.html --open --no-table"
  },
  "engines": {
    "node": ">=23.6.0"
  },
  "dependencies": {
    "@types/spotify-web-api-node": "^5.0.11",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "spotify-web-api-node": "^5.0.2",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.5.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
